[Unit]
Description=SignalShift FastAPI Backend Service ($0 AWS EC2 Deployment)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/signalshift/backend
ExecStart=/home/ubuntu/signalshift/backend/venv/bin/gunicorn \
          -k uvicorn.workers.UvicornWorker \
          -w 1 \
          --threads 4 \
          --bind 127.0.0.1:8002 \
          --timeout 120 \
          app.main:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
